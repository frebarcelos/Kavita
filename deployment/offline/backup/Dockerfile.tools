# Tools for consistent backups of the Kavita configuration volume: the sqlite3 shell (online .backup and
# integrity_check), tar and the backup script. Built by backup-config.ps1; it never runs the server.
FROM alpine:3.20
RUN apk add --no-cache sqlite tar
COPY kavita-backup.sh /usr/local/bin/kavita-backup.sh
RUN sed -i 's/\r$//' /usr/local/bin/kavita-backup.sh && chmod +x /usr/local/bin/kavita-backup.sh
